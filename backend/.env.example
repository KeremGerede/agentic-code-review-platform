DATABASE_URL=sqlite:///./codereviewer.db
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GITHUB_TOKEN=your_github_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
FRONTEND_URL=http://localhost:5173

# Set to true ONLY for local debugging to bypass signature check. Never in production.
DEBUG_SKIP_WEBHOOK_SIGNATURE_CHECK=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=you@gmail.com
SMTP_USE_TLS=true
REPORT_RECIPIENT_EMAILS=team@example.com,manager@example.com
